# Единые переводы строк (LF) для macOS и Windows
* text=auto eol=lf

# Windows-скрипты должны оставаться с CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix-скрипт gradlew — всегда LF
gradlew text eol=lf

# Бинарные файлы
